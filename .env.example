# =============================================================================
# .env.example - MAU cho `docker run --env-file .env` va cho AgentBase Runtime
# =============================================================================
# Cach dung cuc bo:
#   cp .env.example .env
#   -> dien gia tri that (hoac giu rong de chi kiem tra /health, xem docs/17 T14)
#   docker run -p 8080:8080 --env-file .env mkt-insight-agent:v1.0.0
#
# Tren AgentBase Runtime that (docs/12-build-deploy.md muc 12.7): bon bien
# GREENNODE_* duoc NEN TANG TU TIEM vao environmentVariables cua Runtime -
# KHONG dat tay o do, chi can khai bao o day cho truong hop chay container
# NGOAI AgentBase (dev/test cuc bo).
# =============================================================================

APP_PROFILE=greennode

# --- Nen tang GreenNode (tu tiem tren AgentBase Runtime that) ---------------
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
GREENNODE_AGENT_IDENTITY=
GREENNODE_ENDPOINT_URL=

# --- LLM (MaaS) --------------------------------------------------------------
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=
LLM_JUDGE_MODEL=
LLM_API_KEY=

# --- Database (vDB RDS - dung chung local/greennode, xem docs/03 muc 3.5) --
MKT_DATABASE__URL=
MKT_DATABASE__URL_TRACE=

# --- Trang admin (docs/07 muc 7.5) - chuoi ngau nhien, khong dung "CHANGEME" -
MKT_ADMIN__TOKEN=

LOG_LEVEL=info
